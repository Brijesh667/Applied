# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Sessions
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
SESSION_SECRET=<minimum-32-characters-random-string>
COOKIE_SAMESITE=lax
TRUST_PROXY=1
TRUST_PROXY_HOPS=1
AUTH_RATE_LIMIT_MAX=10git 

# Cloudinary Configuration (Private Resume Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Resume Parsing (Anthropic Claude or Google Gemini - Optional)
# AI_PROVIDER: "anthropic" | "google" (default: "anthropic")
AI_PROVIDER=anthropic

# Anthropic Claude Configuration
# If AI_PROVIDER=anthropic and ANTHROPIC_API_KEY is omitted, AI parsing is disabled (parseError: "ai_unavailable")
ANTHROPIC_API_KEY=your_anthropic_api_key_optional
ANTHROPIC_MODEL=claude-haiku-5-5

# Google Gemini Configuration
# If AI_PROVIDER=google and GOOGLE_API_KEY is omitted, AI parsing is disabled (parseError: "ai_unavailable")
GOOGLE_API_KEY=your_google_api_key_optional
GOOGLE_MODEL=gemini-2.5-flash

# Job Search Providers (Optional)
# If no providers are configured/enabled, job search returns 503 Service Unavailable
# Adzuna (both ADZUNA_APP_ID and ADZUNA_APP_KEY required to enable Adzuna)
ADZUNA_APP_ID=your_adzuna_app_id_optional
ADZUNA_APP_KEY=your_adzuna_app_key_optional

# JSearch / RapidAPI (JSEARCH_API_KEY required to enable JSearch)
JSEARCH_API_KEY=your_rapidapi_jsearch_key_optional

# Jooble (JOOBLE_API_KEY required to enable Jooble, register via https://jooble.org/api/about)
JOOBLE_API_KEY=your_jooble_api_key_optional

# Careerjet (CAREERJET_API_KEY required to enable Careerjet, obtained via publisher account website key)
CAREERJET_API_KEY=your_careerjet_api_key_optional
# CAREERJET_LOCALE: Optional Careerjet locale code (default: en_IN). Supported: en_IN, en_GB, en_US, etc.
CAREERJET_LOCALE=en_IN

# JOB_PROVIDERS: Optional comma list to filter enabled providers (adzuna,jsearch,jooble,careerjet,himalayas,remoteok), or "none" to disable all
# Default: all keyed providers with configured keys + himalayas + remoteok
JOB_PROVIDERS=adzuna,jsearch,jooble,careerjet,himalayas,remoteok

# Rolling 24-hour Job Search Limit (Default: 5 searches per 24 hours)
JOB_SEARCH_DAILY_LIMIT=5
JOB_SEARCH_DAILY_WINDOW_HOURS=24

# Optional Seed Script Credentials (Local development only - never use in production)
SEED_EMAIL=you@example.com
SEED_PASSWORD=<your-password>
SEED_NAME=Demo User
SEED_RAHUL_EMAIL=rahul@example.com
SEED_RAHUL_PASSWORD=<your-password>
SEED_RAHUL_NAME=Rahul

# Optional Smoke Test Configuration (Local development only)
BASE_URL=http://localhost:5000
SMOKE_SKIP_AI=1
SMOKE_SKIP_JOBS=1
SMOKE_ALLOW_REMOTE=0
